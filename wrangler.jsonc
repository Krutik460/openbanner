{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openbanner",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    // The Vite build. Unknown paths fall back to index.html.
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    // Only the profile lookup runs code; everything else is served as a static file.
    "run_worker_first": ["/api/*"]
  },
  // Privacy first: no request logs are collected.
  "observability": { "enabled": false }
}
