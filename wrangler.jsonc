{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openbanner",
  "compatibility_date": "2026-10-01",
  "assets": {
    // The Vite build, served as static files only: no Worker code runs. Unknown paths fall back to index.html.
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  // Privacy first: no request logs are collected.
  "observability": { "enabled": false }
}
